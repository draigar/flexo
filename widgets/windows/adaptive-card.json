{
  "type": "AdaptiveCard",
  "$schema": "http://adaptivecards.io/schemas/adaptive-card.json",
  "version": "1.5",
  "body": [
    {
      "type": "TextBlock",
      "text": "Flexo",
      "size": "Small",
      "isSubtle": true
    },
    {
      "type": "TextBlock",
      "text": "${fileName}",
      "weight": "Bolder",
      "wrap": true
    },
    {
      "type": "TextBlock",
      "text": "${status} · ${percent}%",
      "spacing": "None"
    },
    {
      "type": "ProgressBar",
      "value": "${progress}",
      "max": 1
    }
  ],
  "actions": [
    {
      "type": "Action.OpenUrl",
      "title": "Open",
      "url": "flexo://download/${id}"
    }
  ]
}
