{
  "name": "Flexo",
  "version": "0.3.0",
  "private": true,
  "description": "Speed up downloads by combining multiple network connections in parallel",
  "type": "module",
  "scripts": {
    "dev": "vite",
    "build": "tsc -p tsconfig.web.json --noEmit && vite build",
    "preview": "vite preview",
    "tauri": "tauri",
    "tauri:dev": "tauri dev",
    "tauri:build": "tauri build",
    "typecheck": "tsc -p tsconfig.web.json --noEmit",
    "test:engine": "cargo test -p flexo-engine",
    "format": "prettier --write .",
    "format:check": "prettier --check .",
    "release:patch": "node scripts/bump-version.mjs patch",
    "release:minor": "node scripts/bump-version.mjs minor",
    "release:major": "node scripts/bump-version.mjs major",
    "release": "node scripts/bump-version.mjs"
  },
  "dependencies": {
