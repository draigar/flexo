{
  "$schema": "https://schema.tauri.app/config/2",
  "productName": "Flexo",
  "mainBinaryName": "Flexo",
  "version": "0.3.0",
  "identifier": "com.flexo.app",
  "build": {
    "beforeDevCommand": "npm run dev",
    "beforeBuildCommand": "npm run build",
    "devUrl": "http://localhost:1420",
    "frontendDist": "../dist"
  },
  "app": {
    "windows": [
      {
        "label": "main",
        "title": "Flexo",
        "width": 760,
        "height": 560,
        "minWidth": 640,
        "minHeight": 480,
        "decorations": false,
        "resizable": true
      },
      {
        "label": "tray-popover",
        "title": "Flexo",
        "url": "index.html?window=tray",
        "width": 320,
        "height": 480,
        "decorations": false,
        "resizable": false,
        "alwaysOnTop": true,
        "skipTaskbar": true,
        "visible": false
      }
    ],
    "security": {
      "csp": null,
      "capabilities": [
        "default"
      ]
    }
  },
  "plugins": {
    "deep-link": {
      "desktop": {
        "schemes": [
          "flexo"
        ]
      }
    }
  },
  "bundle": {
    "active": true,
    "targets": "all",
    "resources": {
      "../extensions/browser/*": "extensions/browser/"
    },
    "icon": [
      "icons/32x32.png",
      "icons/128x128.png",
      "icons/128x128@2x.png",
      "icons/icon.icns",
      "icons/icon.ico"
    ]
  }
}
