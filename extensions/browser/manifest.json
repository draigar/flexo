{
  "manifest_version": 3,
  "name": "Flexo Capture",
  "version": "0.2.0",
  "description": "Send browser downloads to Flexo and let Flexo take them over.",
  "key": "",
  "permissions": [
    "downloads",
    "nativeMessaging",
    "storage",
    "tabs",
    "webRequest"
  ],
  "host_permissions": [
    "http://127.0.0.1:17890/*",
    "<all_urls>"
  ],
  "background": {
    "service_worker": "background.js"
  },
  "browser_specific_settings": {
    "gecko": {
      "id": "flexo-capture@flexo.app"
    }
  },
  "action": {
    "default_title": "Send to Flexo"
  }
}
