{
  "manifest_version": 3,
  "name": "Flexo Capture",
  "version": "0.2.0",
  "description": "Send browser downloads to Flexo and let Flexo take them over.",
  "permissions": ["downloads", "storage", "tabs", "webRequest"],
  "host_permissions": ["http://127.0.0.1:17890/*", "<all_urls>"],
  "background": {
    "service_worker": "background.js"
  },
  "action": {
    "default_title": "Send to Flexo"
  }
}
